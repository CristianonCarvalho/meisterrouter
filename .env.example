# ==============================================================================
# MeisterRouter — Configuração de Ambiente
# ==============================================================================

# 1. Chave da API OpenRouter (Necessária para o Jev Router / typesafe/jev-1.13)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# 2. Modelo do Jev Decisions
JEV_MODEL=typesafe/jev-1.13

# 3. Porta do Dashboard de Telemetria
MEISTER_DASHBOARD_PORT=5050
MEISTER_DASHBOARD_HOST=127.0.0.1

# 4. Diretório Global de Logs de Telemetria (Opcional, padrão é ~/.meister/logs)
# MEISTER_LOG_DIR=/Users/seu_usuario/.meister/logs
