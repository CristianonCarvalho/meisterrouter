# ==============================================================================
# MeisterRouter — Configuração de Ambiente
# ==============================================================================

# 1. Chave da API OpenRouter (necessária para as decisões configuradas em master)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# 2. Porta do Dashboard de Telemetria
MEISTER_DASHBOARD_PORT=5050
MEISTER_DASHBOARD_HOST=127.0.0.1

# 3. Diretório Global de Logs de Telemetria (Opcional, padrão é ~/.meister/logs)
# MEISTER_LOG_DIR=/Users/seu_usuario/.meister/logs

# 4. Arquivo de configuração declarativa (opcional)
# Defina modelos, harnesses e fallback em meister.config.yaml.
# MEISTER_CONFIG_PATH=/path/to/meister.config.yaml
