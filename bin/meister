#!/usr/bin/env python3
import sys
import os

root_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
venv_dir = os.path.join(root_dir, ".venv")
venv_python = os.path.join(venv_dir, "bin", "python")

# Se houver virtualenv local criada, configura VIRTUAL_ENV e PATH do projeto (E2E-7)
if os.path.exists(venv_python):
    os.environ["VIRTUAL_ENV"] = venv_dir
    venv_bin = os.path.join(venv_dir, "bin")
    cur_path = os.environ.get("PATH", "")
    if not cur_path.startswith(venv_bin):
        parts = [p for p in cur_path.split(os.pathsep) if p and p != venv_bin]
        os.environ["PATH"] = f"{venv_bin}{os.pathsep}{os.pathsep.join(parts)}" if parts else venv_bin
    if sys.executable != venv_python:
        os.execv(venv_python, [venv_python] + sys.argv)

if root_dir not in sys.path:
    sys.path.insert(0, root_dir)

from meister.cli import main

if __name__ == "__main__":
    main()
