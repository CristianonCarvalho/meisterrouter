#!/usr/bin/env bash
# ==============================================================================
# MeisterRouter — Claude Code Hook
# Managed by MeisterRouter
# Intercepts events and injects Jev Router telemetry or rules
# ==============================================================================

EVENT_TYPE="$1"
shift || true
EVENT_PAYLOAD="$@"

if command -v meister &> /dev/null; then
    # Record that a Claude hook event was triggered in the telemetry log.
    python3 -c "
from meister.logger import log_event
log_event('claude_hook', hook_type='$EVENT_TYPE', payload='$EVENT_PAYLOAD'[:200])
" 2>/dev/null || true
fi

exit 0
