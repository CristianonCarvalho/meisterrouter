#!/usr/bin/env bash
# ==============================================================================
# MeisterRouter Git Pre-Commit Gate
# ==============================================================================
set -e

echo "🔮 [MeisterRouter] Executando verificação de pre-commit determinística..."

# 1. Obter diff resumido dos arquivos em stage
DIFF_SUMMARY=$(git diff --cached --stat | tr '\n' ' ')
if [ -z "$DIFF_SUMMARY" ]; then
    echo "ℹ️ [MeisterRouter] Nenhum arquivo alterado em stage. Prosseguindo."
    exit 0
fi

# 2. Executar checagens de teste automáticas se existirem no projeto
TEST_RESULT="pass"

if [ -f "package.json" ]; then
    echo "📦 [MeisterRouter] Detectado projeto Node/JS. Executando testes rápidos..."
    if grep -q '"test"' package.json; then
        npm test || TEST_RESULT="fail"
    fi
elif [ -f "pytest.ini" ] || [ -f "pyproject.toml" ] || [ -f "requirements.txt" ]; then
    echo "🐍 [MeisterRouter] Detectado projeto Python. Executando pytest..."
    pytest -q || TEST_RESULT="fail"
elif [ -f "Cargo.toml" ]; then
    echo "🦀 [MeisterRouter] Detectado projeto Rust. Executando cargo test..."
    cargo test -q || TEST_RESULT="fail"
fi

if [ "$TEST_RESULT" = "fail" ]; then
    echo "❌ [MeisterRouter] Testes falharam! Bloqueando commit."
    exit 1
fi

# 3. Invocar Jev Control se o comando meister estiver disponível
if command -v meister &> /dev/null; then
    echo "⚖️ [MeisterRouter] Consultando Jev Decisions API para autorização do commit..."
    CONTROL_OUTPUT=$(meister control --diff-summary "$DIFF_SUMMARY" --test-result "$TEST_RESULT" --attempts 1 2>/dev/null || echo '{"action": "COMPLETE"}')
    
    ACTION=$(echo "$CONTROL_OUTPUT" | grep -o '"action": *"[^"]*"' | cut -d'"' -f4 || echo "COMPLETE")
    
    if [ "$ACTION" != "COMPLETE" ] && [ "$ACTION" != "VERIFY" ]; then
        echo "🛑 [MeisterRouter] O Jev Router rejeitou o commit! Ação requerida: $ACTION"
        echo "Detalhes do Jev: $CONTROL_OUTPUT"
        exit 1
    fi
    echo "✅ [MeisterRouter] Jev autorizou o commit ($ACTION)."
fi

echo "🚀 [MeisterRouter] Verificação determinística concluída com sucesso."
exit 0
